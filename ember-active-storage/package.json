{
  "name": "@algonauti/ember-active-storage",
  "version": "2.3.0",
  "description": "Power your ember.js application with activestorage",
  "keywords": [
    "ember-addon",
    "activestorage"
  ],
  "license": "MIT",
  "homepage": "https://github.com/algonauti/ember-active-storage",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/algonauti/ember-active-storage.git"
  },
  "bugs": {
    "url": "https://github.com/algonauti/ember-active-storage/issues"
  },
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently \"yarn:lint:*(!fix)\" --names \"lint:\"",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input --cache\"",
    "lint:css:fix": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "concurrently \"yarn:lint:*:fix\" --names \"fix:\"",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo \"A v2 addon does not have tests, run tests in test-app\""
  },
  "dependencies": {
    "@ember/string": "^4.0.1",
    "@embroider/addon-shim": "^1.10.0",
    "spark-md5": "^3.0.2",
    "tracked-built-ins": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/runtime": "^7.27.1",
    "@embroider/addon-dev": "^8.0.1",
    "@eslint/js": "^9.26.0",
    "@ijlee2-frontend-configs/ember-template-lint": "^1.1.0",
    "@ijlee2-frontend-configs/eslint-config-ember": "^1.1.0",
    "@ijlee2-frontend-configs/prettier": "^1.0.0",
    "@ijlee2-frontend-configs/stylelint": "^1.0.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^2.4.1",
    "concurrently": "^9.1.2",
    "ember-template-lint": "^7.7.0",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "rollup": "^4.40.2",
    "rollup-plugin-copy": "^3.5.0",
    "stylelint": "^16.19.1"
  },
  "engines": {
    "node": "12.* || 14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "app-js": {
      "./services/active-storage.js": "./dist/_app_/services/active-storage.js",
      "./utils/file-checksum.js": "./dist/_app_/utils/file-checksum.js",
      "./utils/tests.js": "./dist/_app_/utils/tests.js"
    },
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist"
  ]
}
